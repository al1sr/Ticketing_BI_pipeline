  <transform>
    <name>bronze_ticketing</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MySQL Superstore</connection>
    <execute_each_row>N</execute_each_row>
    <limit>0</limit>
    <sql>SELECT 
    IFNULL(NULLIF(servicio, ''), 'No especificado') AS servicio,
    IFNULL(NULLIF(torre, ''), 'No especificado') AS torre,
    IFNULL(NULLIF(entorno, ''), 'No especificado') AS entorno,
 	IFNULL(NULLIF(estado, ''), 'No especificado') AS estado,
 	IFNULL(NULLIF(estado_cump, ''), 'No especificado') AS estado_cump,
    CASE 
        WHEN tipo_servicio IN (
            'Restauración de infraestructura', 
            'Restauración de servicio a usuario', 
            'Evento de infraestructura') THEN 'Incidencia'
        WHEN tipo_servicio = 'Petición de serv. por el usuario' THEN 'Petición'
        ELSE 'No especificado' 
    END AS clasf_servicios,
	CASE 
        WHEN estado IN (
            'Cerrado', 
            'Resuelto') THEN 'Acabado'
        WHEN estado IN (
            'Pendiente', 
            'Asignado') THEN 'Abierto'
        ELSE 'No especificado' 
    END AS tipo_estado,
	CASE 
        WHEN entorno LIKE '%PROD%' THEN 'PROD'
        WHEN entorno IS NULL OR entorno = '' OR entorno = 'No especificado' THEN 'No especificado'
        ELSE 'NO PROD'
    END AS tipo_entorno,
	CASE 
        WHEN estado_cump IN (
            'Dentro del Objetivo de servicio', 
            'Advertencia de objetivo de servicio') THEN 'ON TIME'
        WHEN estado_cump = 'Objetivos de servicio incumplidos' THEN 'DELAYED'
        ELSE 'No especificado' 
    END AS tipo_cump,
    fecha_creacion,
    numero_inc,
    descripcion,
	tipo_servicio,
    prioridad,
    estado,
    estado_cump,
	duracion_dias  
FROM ticketing.bronze_ticketing
WHERE estado != 'Cancelado'AND numero_inc IS NOT NULL AND numero_inc != '';
</sql>
    <variables_active>N</variables_active>
    <attributes/>
    <GUI>
      <xloc>192</xloc>
      <yloc>144</yloc>
    </GUI>
  </transform>
