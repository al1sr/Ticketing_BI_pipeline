DELETE FROM ticketing.d_estado;
DELETE FROM ticketing.d_entorno;
DELETE FROM ticketing.d_estado_cump;
DELETE FROM ticketing.d_prioridad;

DELETE FROM ticketing.f_ticket;

SET FOREIGN_KEY_CHECKS = 1;</sql>
