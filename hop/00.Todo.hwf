      <connection>MySQL Superstore</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>DELETE FROM ticketing.d_torre WHERE torre IS NULL OR torre = '';
DELETE FROM ticketing.d_clasf_servicio WHERE clasf_servicio IS NULL OR clasf_servicio = '';
DELETE FROM ticketing.d_tipo_estado WHERE tipo_estado IS NULL OR tipo_estado = '';
DELETE FROM ticketing.d_tipo_entorno WHERE tipo_entorno IS NULL OR tipo_entorno = '';
DELETE FROM ticketing.d_tipo_cump WHERE tipo_cump IS NULL OR tipo_cump = '';

DELETE FROM ticketing.d_servicio WHERE servicio IS NULL OR servicio = '';
DELETE FROM ticketing.d_prioridad WHERE prioridad IS NULL OR prioridad = '';
DELETE FROM ticketing.d_estado WHERE estado IS NULL OR estado = '';
DELETE FROM ticketing.d_entorno WHERE entorno IS NULL OR entorno = '';
DELETE FROM ticketing.d_tipo_servicio WHERE tipo_servicio IS NULL OR tipo_servicio = '';
DELETE FROM ticketing.d_estado_cump WHERE estado_cump IS NULL OR estado_cump = '';

DELETE FROM ticketing.f_ticket WHERE id_ticket IS NULL;</sql>
