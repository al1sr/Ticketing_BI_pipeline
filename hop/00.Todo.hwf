      <connection>MySQL Superstore</connection>
      <sendOneStatement>N</sendOneStatement>
      <sql>SET FOREIGN_KEY_CHECKS = 0;

DELETE FROM ticketing.d_torre;
DELETE FROM ticketing.d_clasf_servicio;
DELETE FROM ticketing.d_tipo_estado;
DELETE FROM ticketing.d_tipo_entorno;
DELETE FROM ticketing.d_tipo_cump;

DELETE FROM ticketing.d_servicio;
